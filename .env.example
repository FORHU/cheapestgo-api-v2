# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/cheapestgo_v2

# ── Server ───────────────────────────────────────────────────────────
PORT=4000
API_URL=http://localhost:4000
SITE_URL=http://localhost:3001

# Extra origins a Google sign-in may return to, comma-separated. SITE_URL is always
# allowed and need not be listed. Anything not named here falls back to SITE_URL — the
# allowlist is what keeps "return where you started" from being an open redirect.
# OAUTH_RETURN_ORIGINS=https://admin.cheapestgo.com

NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=change-me-to-a-long-random-string

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Flight Providers ─────────────────────────────────────────────────
DUFFEL_ACCESS_TOKEN=duffel_live_...
MYSTIFLY_USERNAME=
MYSTIFLY_PASSWORD=
MYSTIFLY_ACCOUNT_NUMBER=

# ── Hotel Providers ──────────────────────────────────────────────────
TRAVELGATEX_API_KEY=
TRAVELGATEX_CODE=
ONDA_SECRET_KEY=

# ── Email ────────────────────────────────────────────────────────────
# EMAIL_TRANSPORT picks how mail leaves (src/lib/email/mailer.ts): smtp | resend | log.
# Unset means resend — kept as the rollback until production has run on SMTP.
# EMAIL_TRANSPORT=smtp
RESEND_API_KEY=re_...
# SMTP, for EMAIL_TRANSPORT=smtp. Without SMTP_HOST, booking mail is queued for the retry job.
# 587 is STARTTLS, 465 is TLS from the start; SMTP_SECURE, unset, follows the port.
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# The pool's open connections, and the messages per second across all of them. Set the rate to
# the provider's limit before an admin blast finds it.
# SMTP_MAX_CONNECTIONS=5
# SMTP_RATE_PER_SECOND=10

# ── Internal ─────────────────────────────────────────────────────────
CRON_SECRET=change-me
FUNCTIONS_SECRET=change-me

# ── AI / Personalization ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── External APIs ────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=

# ── Hotel provider ────────────────────────────────────────────────────
# travelgatex | mock. `mock` here on purpose: this file is what a new machine copies, and
# TravelgateX has no sandbox, so `travelgatex` means a real reservation at a real hotel the
# moment credentials exist (ADR-0002). It also gives nothing to work with — the TGX keys below
# are blank, so hotel search returns nothing — while the mock ships a Manila catalogue whose
# QA properties each provoke one failure. docker-compose.yml sets ALLOW_MOCK_HOTEL_PROVIDER,
# needed because it also sets NODE_ENV=production.
HOTEL_PROVIDER=mock
# MOCK_HOTEL_SCENARIO=ok          # ok|price_up|price_down|sold_out|prebook_timeout|book_rejected|book_timeout|cancel_rejected|cancel_timeout
# MOCK_HOTEL_CURRENCY=USD         # USD|PHP|KRW|EUR
# With HOTEL_PROVIDER=mock and EMAIL_TRANSPORT unset, booking mail is logged, not sent
# (see Email above). Password resets and the rest still send.

# Native Google sign-in (mobile #45). The OAuth client IDs an app may present, comma-separated.
# These are the per-platform clients (Android, iOS) — never GOOGLE_CLIENT_ID, which is the web
# client the browser redirect flow uses. An ID token whose `aud` is not in this list is refused.
GOOGLE_NATIVE_CLIENT_IDS=
