# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/cheapestgo_v2

# ── Server ───────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=change-me-to-a-long-random-string

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Flight Providers ─────────────────────────────────────────────────
DUFFEL_ACCESS_TOKEN=duffel_live_...
MYSTIFLY_USERNAME=
MYSTIFLY_PASSWORD=
MYSTIFLY_ACCOUNT_NUMBER=

# ── Hotel Providers ──────────────────────────────────────────────────
TRAVELGATEX_API_KEY=
TRAVELGATEX_CODE=
ONDA_SECRET_KEY=

# ── Email ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Internal ─────────────────────────────────────────────────────────
CRON_SECRET=change-me
FUNCTIONS_SECRET=change-me

# ── AI / Personalization ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── External APIs ────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
